GEMINI_API_KEY=
GEMINI_MODEL=

# Limite diário de análises (padrões: 150 no site e 10 por pessoa)
LIMITE_DIARIO_SITE=150
LIMITE_DIARIO_IP=10
# Sal do hash do IP (obrigatório em produção). Gere com: openssl rand -hex 32
LIMITE_SAL=

# Upstash Redis (obrigatório em produção; em desenvolvimento, sem ele, o limite fica em memória).
# A integração Upstash da Vercel cria KV_REST_API_URL e KV_REST_API_TOKEN; esses nomes também funcionam.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
